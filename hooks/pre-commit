#!/bin/sh
# SecureGuard pre-commit hook.
# Scans src/ only - tests/fixtures/*/vulnerable/ is intentionally vulnerable
# and must never be scanned here.
# Bypass in a real emergency: git commit --no-verify
#
# One-time setup per clone:
#   git config core.hooksPath hooks

OUTPUT=$(python -m secureguard scan src --baseline secureguard-baseline.json --format json 2>&1)
SCAN_STATUS=$?

if [ "$SCAN_STATUS" -ne 0 ]; then
    echo ""
    echo "SecureGuard: scan failed to run (exit $SCAN_STATUS) - commit blocked as a precaution."
    echo "$OUTPUT"
    echo ""
    exit 1
fi

COUNT=$(echo "$OUTPUT" | python -c "import json,sys; print(len(json.load(sys.stdin)['findings']))" 2>/dev/null)

if [ -z "$COUNT" ] || [ "$COUNT" -gt 0 ] 2>/dev/null; then
    echo ""
    echo "SecureGuard: possible security issue(s) found in src/, or the report could not be parsed - commit blocked."
    echo "Run 'python -m secureguard scan src' to see details."
    echo "If already reviewed and accepted, update the baseline:"
    echo "  python -m secureguard baseline src secureguard-baseline.json"
    echo ""
    exit 1
fi

exit 0